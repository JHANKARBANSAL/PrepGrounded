# ------------------------------------------------------------------
# Copy this file to .env and fill in what you have.
# The project runs fully WITHOUT any API key (local + mock providers).
# ------------------------------------------------------------------

PORT=4000

# --- Embeddings -----------------------------------------------------
# local  = deterministic lexical embedding, no network, no key (default)
# gemini = real semantic embeddings (needs GEMINI_API_KEY)
EMBEDDING_PROVIDER=local

# --- LLM ------------------------------------------------------------
# mock   = deterministic template output, no network (default, demo-safe)
# gemini | groq | openai
LLM_PROVIDER=mock

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Retrieval scoring weights (must sum to 1.0) --------------------
W_SIM=0.60
W_REC=0.30
W_OUT=0.10

# --- Temporal decay -------------------------------------------------
# LAMBDA_BASE is the fixed lambda used by mode="fixed", and the floor
# from which adaptive lambda is scaled up by measured drift.
# lambda 0.35 -> half-life ~2.0 years
LAMBDA_BASE=0.35
DRIFT_GAIN=1.6
