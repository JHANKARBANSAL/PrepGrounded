# PrepGrounded Environment Configuration
# Copy this file to .env or set environment variables in your deployment platform

# Server Port
PORT=4000

# Environment Mode ('production' | 'development')
NODE_ENV=production

# Frontend API URL (for production client build)
VITE_API_BASE=http://localhost:4000

# Allowed CORS Origin (for separate frontend hosting if applicable)
CLIENT_ORIGIN=http://localhost:5173

# Embedding Provider (Optional Gemini API key for live vector generation)
# GEMINI_API_KEY=your_gemini_api_key_here

# Weekly Ingestion Scheduler Settings
INGESTION_CRON=0 3 * * 0
INGESTION_SCHEDULE_ENABLED=true

# Baseline Temporal Scoring Parameters
LAMBDA_BASE=0.35
W_SIM=0.60
W_REC=0.40
